<% dummy_page_nav(title: "Web reader", back_url: root_path) %>

<%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
  <%= render FlatPack::PageTitle::Component.new(
    title: "Web reader",
    subtitle: "Fetch a public page and inspect the normalized result.",
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get do %>
    <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
      <%= render FlatPack::TextInput::Component.new(
        name: "url",
        label: "URL",
        value: params[:url],
        placeholder: "https://example.com/article"
      ) %>
      <%= render FlatPack::Checkbox::Component.new(
        name: "probe",
        checked: params[:probe] == "1",
        label: "Probe image dimensions"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Read page",
        style: :primary,
        type: :submit
      ) %>
    <% end %>
  <% end %>

  <% if @error %>
    <%= render FlatPack::Alert::Component.new(
      style: :danger,
      description: @error.message
    ) %>
  <% end %>

  <% if @page %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: @page.title.presence || "Untitled page",
          subtitle: @page.final_url,
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true) do %>
          <% [
            ["Requested URL", @page.url],
            ["Final URL", @page.final_url],
            ["Status", @page.status],
            ["Content type", @page.content_type],
            ["Description", @page.description],
            ["Canonical URL", @page.canonical_url]
          ].each do |label, value| %>
            <%= render FlatPack::List::Item.new(leading: label) do %>
              <span class="break-all"><%= value %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Text", variant: :h3, class: "mb-0 pb-0") %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::CodeBlock::Component.new(
          code: @page.text.to_s[0, 8_000],
          language: :text,
          title: "Main text",
          wrap: true
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Metadata", variant: :h3, class: "mb-0 pb-0") %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::CodeBlock::Component.new(
          code: JSON.pretty_generate(@page.metadata.to_h),
          language: :json,
          title: "Metadata",
          wrap: true
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Links", variant: :h3, class: "mb-0 pb-0") %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::Table::Component.new(data: @page.links) do |table| %>
          <% table.column(title: "URL") { |link| link[:url] } %>
          <% table.column(title: "Text") { |link| link[:text] } %>
          <% table.column(title: "Rel") { |link| Array(link[:rel]).join(" ") } %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Images", variant: :h3, class: "mb-0 pb-0") %>
      <% end %>
      <% card.body do %>
        <%= render FlatPack::Table::Component.new(data: @page.images, min_width: :lg) do |table| %>
          <% table.column(title: "URL") { |image| image[:url] } %>
          <% table.column(title: "Alt") { |image| image[:alt] } %>
          <% table.column(title: "Width") { |image| image[:width] } %>
          <% table.column(title: "Height") { |image| image[:height] } %>
          <% table.column(title: "Source") { |image| image[:dimension_source] } %>
          <% table.column(title: "Variants") { |image| Array(image[:variants]).map { |variant| [variant[:width_hint], variant[:url]].compact.join(" ") }.join(", ") } %>
        <% end %>
      <% end %>
    <% end %>

    <% if @paywall %>
      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Dummy paywall analysis",
            subtitle: "Registered by the dummy app. It is not a product classifier.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>
        <% card.body do %>
          <%= render FlatPack::CodeBlock::Component.new(
            code: JSON.pretty_generate(@paywall.to_h),
            language: :json,
            title: "Analysis",
            wrap: true
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
